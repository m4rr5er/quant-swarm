# ── LLM profiles ─────────────────────────────────────────────
# Referenced by configs/settings.yaml -> llm.profiles.<name>.api_key_env
# Define as many profiles as you like; each agent/brain picks one by name.
# Examples: DeepSeek / Qwen (DashScope-compatible) / OpenAI / Ollama / any
# OpenAI-compatible third-party gateway.
LLM_API_KEY_DEFAULT=
LLM_API_KEY_ALT=

# ── Data providers ───────────────────────────────────────────
# AKShare needs no token. Tushare Pro requires one (optional in MVP).
TUSHARE_TOKEN=

# ── Infrastructure ───────────────────────────────────────────
# QS_BUS: nats (core) | nats_js (JetStream, needs nats-server -js) | local (tests)
QS_BUS=nats
QS_NATS_URL=nats://127.0.0.1:4222
QS_DB_PATH=./data/quantswarm.db
QS_MEMORY_DIR=./memory
QS_LOG_DIR=./logs

# telegram bot token from @BotFather — enables im_telegram gateway
QS_TG_TOKEN=
