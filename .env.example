# ── LLM profiles ─────────────────────────────────────────────
# Referenced by configs/settings.yaml -> llm.profiles.<name>.api_key_env
# Define as many profiles as you like; each agent/brain picks one by name.
# Examples: DeepSeek / Qwen (DashScope-compatible) / OpenAI / Ollama / any
# OpenAI-compatible third-party gateway.
LLM_API_KEY_DEFAULT=
LLM_API_KEY_ALT=

# ── Data providers ───────────────────────────────────────────
# AKShare needs no token. Tushare Pro requires one (optional in MVP).
TUSHARE_TOKEN=

# ── Infrastructure ───────────────────────────────────────────
NATS_URL=nats://127.0.0.1:4222
QUANTSWARM_DB_PATH=./data/quantswarm.db
QUANTSWARM_LOG_DIR=./logs
